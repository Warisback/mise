# Copy to .env and fill in. Never commit .env.

# --- Stripe: TEST MODE ONLY (sk_test_...). The app refuses to start on a live key. ---
STRIPE_SECRET_KEY=sk_test_...
# Optional: only if you point a Stripe webhook at an ngrok URL + /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# stripe = the card's Stripe spending limit declines overcharges (the real thing)
# code   = the app refuses overcharges before Stripe sees them (fallback if test-mode limits misbehave)
CAP_CHECK=stripe

# --- Agent model ---
# OpenAI (used when ANTHROPIC_API_KEY is empty)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1
# Anthropic (used instead of OpenAI when set)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# scripted = no model at all: same tools, same policy gate, templated wording (demo safety net)
AGENT_MODE=

CURRENCY=gbp
# Empty = all tools (forecast_covers, plan_order, negotiate, place_order, recall_memory, list_recent_actions)
ENABLED_TOOLS=

# --- Memory: local (zero setup) | cognee ---
MEMORY_BACKEND=cognee
# Cognee Cloud (credit code cognee35): platform.cognee.ai -> API Keys
COGNEE_URL=https://tenant-....aws.cognee.ai
COGNEE_API_KEY=
COGNEE_DATASET=mise
ENABLE_BACKEND_ACCESS_CONTROL=false

# --- Supplier chat over Telegram (optional): token from @BotFather ---
TELEGRAM_BOT_TOKEN=
